# ============================================================
# CONFIGURAZIONE ANNUNCI - Kingdom of Pleasure
# ============================================================
# Copia questo file in .env.local per sviluppo locale,
# oppure imposta queste variabili nel dashboard Vercel.
# ============================================================

# Abilita il sistema di annunci (default: false = Safe Mode senza annunci)
# Metti "true" su Vercel per attivare la monetizzazione in produzione
VITE_ADS_ENABLED=false

# ------------------------------------------------------------
# BANNER FISSO IN BASSO (ExoClick - Display Ad 320x50)
# ------------------------------------------------------------
# 1. Registrati su https://www.exoclick.com (Publisher)
# 2. Aggiungi il tuo sito e aspetta approvazione (adult content OK)
# 3. Crea una zona "Display Banner" → formato 320x50 (Mobile Banner)
# 4. Copia il "Zone ID" numerico e incollalo qui
VITE_ADS_BANNER_ZONE_ID=

# ------------------------------------------------------------
# REWARDED VIDEO AD (sblocco Livello 2 e Livello 3)
# ------------------------------------------------------------
# L'utente guarda un video prima di accedere ai livelli premium.
# Usa il Google IMA SDK già incluso nella pagina con un VAST tag ExoClick:
# 1. Su ExoClick crea una zona "Video - Pre/Mid/Post Roll" (In-Stream Video)
# 2. Seleziona formato VAST, ottieni il VAST Tag URL
# 3. Incollalo qui
VITE_ADS_REWARDED_VAST_URL=

# ------------------------------------------------------------
# INTERSTITIAL VIDEO AD (solo Livello 3)
# ------------------------------------------------------------
# Appare ogni 2 attività completate, massimo 3 volte per sessione.
# Stessa procedura del rewarded: crea una zona video su ExoClick.
# Può essere lo stesso VAST URL del rewarded, oppure una zona separata
# per ottimizzare i guadagni con campagne diverse.
VITE_ADS_INTERSTITIAL_VAST_URL=

# ------------------------------------------------------------
# TEST MODALITÀ
# ------------------------------------------------------------
# Aggiungi ?adtest=on all'URL per testare gli annunci in locale
# senza contare le impression (ExoClick lo supporta nel VAST tag)
VITE_DEBUG=false
